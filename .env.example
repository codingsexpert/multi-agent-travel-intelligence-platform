# ==============================================================================
# Multi-Agent AI Travel Intelligence & Dynamic Replanning Platform
# Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=development                 # Options: development, staging, production
APP_PORT=8501                       # Default Streamlit port
DEBUG=true
DEMO_MODE=true                      # When true, uses deterministic mock tools instead of external APIs
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ------------------------------------------------------------------------------
# 2. LLM PROVIDERS
# ------------------------------------------------------------------------------
# Primary reasoning LLM (used for Planner, Replanner, Synthesis)
PRIMARY_LLM_PROVIDER=openai         # Options: openai, anthropic, google
OPENAI_API_KEY=your_openai_api_key_here
PRIMARY_LLM_MODEL=gpt-4o

# Fast/Cost-effective LLM (used for extraction, summarization, tool formatting)
FAST_LLM_MODEL=gpt-4o-mini

# Optional Alternative Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 3. LANGSMITH OBSERVABILITY & TRACING
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=travel-intelligence-platform

# ------------------------------------------------------------------------------
# 4. SUPABASE CONFIGURATION (POSTGRESQL, AUTH & PGVECTOR)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Service role key should ONLY be used in server-side admin migrations / maintenance scripts
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_DB_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Vector Search / Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# 5. MODEL CONTEXT PROTOCOL (MCP) SERVERS
# ------------------------------------------------------------------------------
MCP_WEATHER_SERVER_URL=http://localhost:8001/mcp
MCP_FLIGHTS_SERVER_URL=http://localhost:8002/mcp
MCP_HOTELS_SERVER_URL=http://localhost:8003/mcp

# ------------------------------------------------------------------------------
# 6. EXTERNAL TRAVEL APIS (Optional when DEMO_MODE=true)
# ------------------------------------------------------------------------------
# Flights & Hotels (Amadeus for Live flight & hotel availability)
AMADEUS_CLIENT_ID=your_amadeus_api_key_here
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_here

# Weather (Open-Meteo is used by default with zero key required; optional OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Web Search (Tavily for fast AI web retrieval; open Wikipedia search used as fallback)
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Places & Routing (OpenStreetMap/Photon & OSRM used by default; optional Google Places)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ------------------------------------------------------------------------------
# 7. GUARDRAILS, SAFETY & EXECUTION BOUNDARIES (Phase 11)
# ------------------------------------------------------------------------------
MAX_AGENT_STEPS=15                  # Maximum autonomous agent steps per workflow run
MAX_TOOL_CALLS=25                   # Maximum tool invocations per workflow run
MAX_RETRIES=2                       # Maximum retry attempts per tool operation
MAX_SEARCH_CALLS=5                  # Maximum external web search queries per workflow
MAX_RAG_RESULTS=10                  # Maximum retrieved knowledge chunks per query
MAX_INPUT_CHARS=2000                # Maximum length of user travel prompt
MAX_CONTEXT_CHARS=15000             # Maximum size of LLM retrieved context
WORKFLOW_TIMEOUT_SECONDS=30.0       # Circuit breaker timeout for overall workflow
RATE_LIMIT_REQUESTS=60              # Bounded requests per window
RATE_LIMIT_WINDOW_SECONDS=60        # Sliding rate limit window duration in seconds
MAX_BUDGET_CURRENCY=USD
ENABLE_PROMPT_INJECTION_CHECK=true
ENABLE_HUMAN_APPROVAL=true          # Mandatory for booking, payment, and financial transactions

